    {
      "id": "claim_334574aeadc640b5a5c5114557e08fed",
      "statement": "The runtime pipeline is a four-stage chain (rewrite_query, retrieve_documents, rerank, generate_response) orchestrated by the untraced _run_pipeline and exposed through two traced root entrypoints — arxiv_copilot returns the answer string while arxiv_copilot_with_sources returns (answer, documents) under the same arxiv_copilot trace name; rewrite and rerank are disabled pass-throughs that raise NotImplementedError when their RunConfig toggles are enabled, reserving them as CKPT-5 and CKPT-4 extension seams.",
      "evidence": [
        {
          "resource": "repo://app.py#L52-L132",
          "version": "repo-lines-v1:sha256:9772dc53441d70388f427d92b7ca4d788bb0a3624aa2fa1f0d9e2d2fb4fee229:"
        }
